<?php

use Krystal\Form\Element;
use Cms\Service\LanguageManager;

?>

<form class="card" autocomplete="off">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#translations" data-bs-toggle="tab">
                    <i class="bi bi-folder"></i> <?= $this->translate('Category'); ?>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#category" data-bs-toggle="tab">
                    <i class="bi bi-gear"></i> <?= $this->translate('Options'); ?>
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane fade show active" id="translations">
