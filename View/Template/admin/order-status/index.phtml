<?php

use Krystal\Widget\GridView\GridViewWidget;
use Krystal\Form\Element;
use Cms\View\Icon;

defined('KRYSTAL') or die;

?>

<div class="btn-toolbar mb-3">
    <div class="btn-group mr-2">
        <a class="btn btn-primary" href="<?= $this->url('Shop:Admin:OrderStatus@addAction'); ?>">
            <i class="bi bi-plus-lg"></i> <?= $this->translate('Add new order status'); ?>
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title m-0">
            <i class="bi bi-list-check"></i> <?= $this->translate('Available order statuses'); ?> 
            <small class="text-muted">(<?= count($orderStatuses); ?>)</small>
        </h3>
    </div>

    <div class="card-body table-responsive">
        <?= $this->widget(new GridViewWidget($orderStatuses, [
            'tableClass' => 'table table-hover table-bordered table-striped',
            'columns' => [
                [
                    'column' => 'id',
                    'label' => '#'
                ],
                [
                    'column' => 'name',
                    'attributes' => [
                        'class' => 'text-left'
                    ]
                ],
                [
                    'column' => 'description',
                    'attributes' => [
                        'class' => 'text-left'
                    ]
                ],
                [
                    'column' => 'order'
                ]
            ],

            'actions' => [
                function($row){
                    return Icon::edit(
                        $this->url('Shop:Admin:OrderStatus@editAction', $row['id']),
                        $this->translate('Edit this order status')
                    );
                },

                function($row){
                    return Icon::remove(
                        $this->url('Shop:Admin:OrderStatus@deleteAction', $row['id']),
                        $this->translate('Remove this order status'),
                        null,
                        $this->url('Shop:Admin:OrderStatus@indexAction')
                    );
                }
            ]
        ])); ?>

        <?php if (empty($orderStatuses)): ?>
        <div class="text-center py-5">
            <h2 class="text-muted"><i class="bi bi-x-circle"></i> <?= $this->translate('No order statuses'); ?></h2>
        </div>
        <?php endif; ?>
    </div>
</div>