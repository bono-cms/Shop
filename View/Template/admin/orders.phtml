<?php

use Krystal\Form\Element;
use Krystal\Widget\GridView\GridViewWidget;
use Cms\View\Icon;

defined('KRYSTAL') or die;

$route = $this->url('Shop:Admin:Order@filterAction', null);

?>

<div class="btn-toolbar mb-3">
    <div class="dropdown">
        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
            <i class="bi bi-list"></i> <?php $this->show('Menu'); ?>
        </button>

        <div class="dropdown-menu">
            <a class="dropdown-item" href="<?= $this->url('Shop:Admin:OrderStatus@indexAction'); ?>">
                <i class="bi bi-type-h1"></i> <?php $this->show('Order statuses'); ?>
            </a>
            <div class="dropdown-divider"></div>
            <?php if (!empty($orders)): ?>
            <a class="dropdown-item" href="#" data-button="save-changes" data-url="<?= $this->url('Shop:Admin:Order@tweakAction'); ?>">
                <i class="bi bi-save"></i> <?php $this->show('Save changes'); ?>
            </a>
            <a class="dropdown-item text-danger" href="#" data-button="remove-selected" data-url="<?= $this->url('Shop:Admin:Order@deleteAction', null); ?>">
                <i class="bi bi-x-circle"></i> <?php $this->show('Remove selected'); ?>
            </a>
            <?php else: ?>
            <a class="dropdown-item disabled"><i class="bi bi-save"></i> <?php $this->show('Save changes'); ?></a>
            <a class="dropdown-item disabled"><i class="bi bi-x-circle"></i> <?php $this->show('Remove selected'); ?></a>
            <?php endif; ?>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title m-0">
            <i class="bi bi-person"></i> <?php $this->show('Orders'); ?> 
            <small class="text-muted">(<?= $paginator->getTotalAmount(); ?>)</small>
        </h3>
    </div>

    <div class="card-body">
        <?php $this->loadPartial('items-per-page', ['caption' => 'Recent orders']); ?>

        <form action="<?= $route; ?>" novalidate autocomplete="off">
            <?= $this->widget(new GridViewWidget($orders, [
                'batch' => true,
                'pk' => 'id',
                'tableClass' => 'table table-hover table-bordered table-striped',
                'rowAttributes' => [
                    'class' => function($order){
                        return !$order->getApproved() ? 'table-warning' : null;
                    }
                ],

                'columns' => [
                    [
                        'column' => 'id',
                        'label' => '#'
                    ],
                    [
                        'column' => 'order_status_id',
                        'attributes' => [
                            'class' => 'col-2'
                        ],
                        'label' => 'Order status',
                        'type' => 'select',
                        'filter' => $orderStatuses,
                        'value' => function($order) use ($orderStatuses){
                            return Element::select(sprintf('order_status_id[%s]', $order->getId()), $orderStatuses, $order->getStatusId(), ['class' => 'form-control'], null);
                        }
                    ],
                    [
                        'column' => 'name',
                        'filter' => true
                    ],
                    [
                        'column' => 'delivery',
                        'label' => 'Delivery type'
                    ],
                    [
                        'column' => 'qty',
                        'filter' => true
                    ],
                    [
                        'column' => 'total_price',
                        'label' => 'Total price',
                        'filter' => true,
                        'value' => function($order) use ($config){
                            return number_format($order->getTotalPrice()) . ' ' . $config->getCurrency();
                        }
                    ],
                    [
                        'column' => 'discount',
                        'value' => function($order) use ($config){
                            return number_format($order->getDiscount()) . ' ' . $config->getCurrency();
                        }
                    ],
                    [
                        'column' => 'approved',
                        'translateable' => true,
                        'type' => 'select',
                        'filter' => 'boolean',
                        'value' => function($order){
                            return $order->getApproved() ? 'Yes' : 'No';
                        }
                    ]
                ],

                'actions' => [
                    function($order) {
                        if (!$order->getApproved()) {
                            return Icon::approve(
                                $this->url('Shop:Admin:Order@approveAction', $order->getId()),
                                $this->translate('Approve this order')
                            );
                        }
                        return null;
                    },
                    function($order) {
                        return Icon::details(
                            $this->url('Shop:Admin:Order@detailsAction', $order->getId()),
                            $this->translate('View purchased products')
                        );
                    },
                    function($order) {
                        return Icon::remove(
                            $this->url('Shop:Admin:Order@deleteAction', $order->getId()),
                            $this->translate('Remove this order')
                        );
                    }
                ]
            ]), $route); ?>

            <?php if (empty($orders)): ?>
            <div class="text-center py-5">
                <h2 class="text-muted"><i class="bi bi-x-circle"></i> <?php $this->show('No orders'); ?></h2>
            </div>
            <?php else: ?>
            <div class="mt-3">
                <?php if ($appliedFilter): ?>
                <a href="<?= $this->url('Shop:Admin:Order@indexAction'); ?>" class="btn btn-secondary">
                    <i class="bi bi-trash"></i> <?php $this->show('Reset filter'); ?>
                </a>
                <?php endif; ?>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> <?php $this->show('Filter'); ?>
                </button>
            </div>
            <?php endif; ?>
        </form>
        
        <div class="mt-4">
            <?php $this->loadPartial('paginator'); ?>
        </div>
    </div>
</div>

<div class="modal fade" id="details-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><i class="bi bi-eye"></i> <?php $this->show('Order details'); ?></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="details-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">
                    <i class="bi bi-check-lg"></i> OK
                </button>
            </div>
        </div>
    </div>
</div>